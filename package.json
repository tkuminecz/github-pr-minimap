{
  "name": "github-pr-minimap",
  "version": "0.1.0",
  "private": true,
  "description": "Chrome extension that adds an activity minimap to GitHub pull request conversations",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "vite build",
    "watch": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "fixtures": "node scripts/fetch-fixtures.mjs",
    "smoke": "pnpm build && node scripts/smoke.mjs",
    "perf": "pnpm build && node scripts/perf.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/chrome": "^0.3.4",
    "@types/jsdom": "^30.0.0",
    "jsdom": "^30.1.1",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
